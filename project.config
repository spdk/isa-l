[access]
	inheritFrom = All-Projects
[submit]
[project]
	description = Intelligent Storage Acceleration Library
[access "refs/*"]
	owner = group user/Ben Walker (benlwalker)
[access "refs/for/refs/*"]
	label-Code-Review = -2..+2 group user/Ben Walker (benlwalker)
	label-Verified = -1..+1 group user/Ben Walker (benlwalker)
	push = group user/Ben Walker (benlwalker)
	read = group user/Ben Walker (benlwalker)
	rebase = group user/Ben Walker (benlwalker)
	removeReviewer = group user/Ben Walker (benlwalker)
	submit = group user/Ben Walker (benlwalker)
[access "refs/heads/*"]
	create = group user/Ben Walker (benlwalker)
	push = +force group user/Ben Walker (benlwalker)
	pushMerge = group user/Ben Walker (benlwalker)
	read = group user/Ben Walker (benlwalker)
[access "refs/tags/*"]
	push = group user/Ben Walker (benlwalker)
	push = +force group user/Ben Walker (benlwalker)
